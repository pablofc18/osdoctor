# Maintainer: pablofc18 <pablofc18@gmail.com>
pkgname=osdoctor
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux desktop health checks for Arch/Hyprland systems"
arch=('x86_64' 'aarch64')
url="https://github.com/pablofc18/osdoctor"
license=('MIT')
depends=('glibc')
makedepends=('gcc' 'make')
optdepends=('hyprland: Hyprland desktop/session checks'
            'waybar: Waybar configuration checks')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replace with the real checksum for a tagged release, e.g. via `updpkgsums`.
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    make
}

check() {
    cd "$pkgname-$pkgver"
    make test
}

package() {
    cd "$pkgname-$pkgver"
    # Arch packages install under /usr, not /usr/local.
    make PREFIX=/usr DESTDIR="$pkgdir" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
