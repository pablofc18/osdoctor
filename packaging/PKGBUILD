# Maintainer: pablofc18 <pablofc18@gmail.com>
pkgname=osdoctor
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux desktop health checks for Arch/Hyprland systems"
arch=('x86_64' 'aarch64')
url="https://github.com/pablofc18/osdoctor"
license=('MIT')
depends=('glibc')
makedepends=('rust' 'cargo')
optdepends=('hyprland: Hyprland desktop/session checks'
            'waybar: Waybar configuration checks'
            'pacman: package checks'
            'systemd: service checks')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replace with the real checksum for a tagged release, e.g. via `updpkgsums`.
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "man/osdoctor.1" "$pkgdir/usr/share/man/man1/osdoctor.1"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
